{
  "//extends": "pick from: stylomatic/{node-library|react-library|nextjs|base}.json",
  "extends": "stylomatic/node-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "strict": false,
    "isolatedModules": false,
    "skipLibCheck": true
  },
  "include": ["./src"],
  "exclude": ["**/__tests__/", "test/fixtures", "src/**/*.spec.ts"]
}
